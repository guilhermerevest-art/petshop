{
  "name": "petshop",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @petshop/db generate",
    "db:migrate": "pnpm --filter @petshop/db migrate",
    "db:seed": "pnpm --filter @petshop/db seed",
    "e2e": "pnpm --filter @petshop/web e2e"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}

# ---------------------------------------------------------------------------
# Aplicação web (Vercel: Settings → Environment Variables)
# ---------------------------------------------------------------------------

# Endereço público do sistema (sem barra no final).
APP_URL=http://localhost:3000

# Conexão da APLICAÇÃO: papel petshop_app, via PgBouncer (modo transaction), com SSL em produção.
# Ex.: postgres://petshop_app:SENHA@db.seudominio.com.br:6432/petshop?sslmode=require
DATABASE_URL=postgres://petshop_app:petshop_app@localhost:5432/petshop

# Conexão do DONO das tabelas, direta (sem PgBouncer). Usada só para rodar migrações.
DATABASE_URL_OWNER=postgres://petshop_owner:petshop_owner@localhost:5432/petshop

# Segredo das sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mails com acesso ao painel da plataforma (/admin), separados por vírgula.
PLATFORM_ADMIN_EMAILS=

# --- Assinatura dos pet shops (Stripe) --------------------------------------
# Sem estas chaves, em desenvolvimento, o sistema usa um checkout simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preço recorrente (price_...) do plano, criado no painel do Stripe.
STRIPE_PRICE_ID=
# Dias de teste grátis (0 = sem teste).
BILLING_TRIAL_DAYS=14
# Força o provedor: stripe | fake. Em produção, deixe vazio (usa o Stripe).
BILLING_PROVIDER=

# --- WhatsApp (Evolution API) ------------------------------------------------
# Sem estas variáveis, em desenvolvimento, o sistema usa um WhatsApp simulado.
EVOLUTION_API_URL=
# Chave global da Evolution (AUTHENTICATION_API_KEY). Nunca exponha no navegador.
EVOLUTION_API_KEY=
# Token que a Evolution manda de volta nos webhooks. Gere com: openssl rand -hex 24
EVOLUTION_WEBHOOK_TOKEN=
# Força o provedor: evolution | fake.
MESSAGING_PROVIDER=
# Simulador: em quantos milissegundos o "celular" conecta depois de pedir o QR Code.
FAKE_WHATSAPP_CONNECT_MS=6000

# --- E-mail (convites e recuperação de senha) --------------------------------
# Qualquer SMTP: smtps://usuario:senha@smtp.provedor.com:465
# Sem SMTP, os e-mails aparecem no log do servidor.
SMTP_URL=
EMAIL_FROM=PetShop <nao-responda@seudominio.com.br>
